# ===== VERCEL (Next.js App) =====
MONGODB_URI=mongodb+srv://username:password@cluster0.xxx.mongodb.net/campusconnect?retryWrites=true&w=majority
NEXTAUTH_SECRET=generate-a-64-char-random-string-here
NEXTAUTH_URL=https://your-app.vercel.app
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# Socket server URL (your Render.com deployment)
NEXT_PUBLIC_SOCKET_URL=https://your-socket-server.onrender.com
SOCKET_SERVER_URL=https://your-socket-server.onrender.com

# CORS (your Vercel app URL)
CORS_ORIGINS=https://your-app.vercel.app

# ===== RENDER.COM (Socket Server) =====
# Set these as env vars on Render dashboard:
# MONGODB_URI=same-as-above
# CORS_ORIGINS=https://your-app.vercel.app
# NODE_ENV=production
